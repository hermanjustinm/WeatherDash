# Copy this file to .env and fill in your values

# AirNow API key - get free key at https://docs.airnowapi.org/account/request/
AIRNOW_API_KEY=your_airnow_api_key_here

# Flask settings
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Location settings (Olympia, WA defaults)
LAT=47.0379
LON=-122.9007
LOCATION_NAME=Olympia, WA
TIMEZONE=America/Los_Angeles

# Optional: WA DOT API key for traffic cameras
# Get at: https://wsdot.wa.gov/traffic/api/
WSDOT_API_KEY=

# Cache timeout overrides (seconds) - optional
# CACHE_RADAR_TTL=300
# CACHE_CURRENT_TTL=600
# CACHE_FORECAST_TTL=1800
# CACHE_ALERTS_TTL=120
# CACHE_AQI_TTL=1800
# CACHE_RIVER_TTL=900
# CACHE_TIDES_TTL=1800
# CACHE_CAMERAS_TTL=60
