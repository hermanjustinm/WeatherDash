# Copy to .env and adjust values
FLASK_ENV=production
HOST=0.0.0.0
PORT=5000

# Olympia, WA
LATITUDE=47.0379
LONGITUDE=-122.9007
TIMEZONE=America/Los_Angeles
COUNTY_ZONE=WAC067

# Optional API key
AIRNOW_API_KEY=

# Optional embed URLs
LIGHTNING_EMBED_URL=https://www.lightningmaps.org
POWER_OUTAGE_EMBED_URL=https://poweroutage.us/area/state/washington

# Comma-separated origins for browser clients (GitHub Pages, LAN viewers, etc.)
CORS_ALLOWED_ORIGINS=*
